{
 "examples": [
  {
   "branch": "pain-mech",
   "text": "Pain receptors in the skin send signals to the spinal cord.",
   "act_raw": 25.0,
   "token": " receptors"
  },
  {
   "branch": "pain-mech",
   "text": "Local anesthetics block the transmission of pain signals along nerves.",
   "act_raw": 15.8125,
   "token": " pain"
  },
  {
   "branch": "pain-mech",
   "text": "Morphine dampens pain signals before they reach the brain.",
   "act_raw": 19.875,
   "token": " signals"
  },
  {
   "branch": "touch-temp",
   "text": "Nerve endings in the skin respond to pressure.",
   "act_raw": 18.75,
   "token": " pressure"
  },
  {
   "branch": "touch-temp",
   "text": "The fingertips are highly sensitive to touch and temperature.",
   "act_raw": 8.9375,
   "token": " temperature"
  },
  {
   "branch": "touch-temp",
   "text": "Light touch and vibration are sensed by different receptors in the skin.",
   "act_raw": 7.4375,
   "token": " receptors"
  },
  {
   "branch": "withdrawal",
   "text": "She flinched and pulled her hand away from the flame.",
