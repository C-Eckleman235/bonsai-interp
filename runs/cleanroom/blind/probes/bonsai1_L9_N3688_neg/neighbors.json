   "token": " hand"
  },
  {
   "branch": "withdrawal",
   "text": "She yanked her hand back the moment she touched the hot iron.",
   "act_raw": 16.875,
   "token": " back"
  },
  {
   "branch": "withdrawal",
   "text": "She drew back in surprise when the door burst open.",
   "act_raw": 7.25,
   "token": " back"
  }
