   "fire": [
    {
     "text": "Pain fibres in the skin relay signals to the dorsal horn of the spinal cord.",
     "act": 1.1885964912280702,
     "opp": 0.01870748299319728,
     "act_spread": 0.2894736842105263,
     "peak_token": "res",
     "peak_char": 11
    },
    {
     "text": "Heat-sensitive receptors make a hot surface feel painful.",
     "act": 1.1008771929824561,
     "opp": 0.02759353741496599,
     "act_spread": 0.09210526315789469,
     "peak_token": " painful",
     "peak_char": 56
    },
    {
     "text": "Patients with nerve damage often report burning, tingling and numbness.",
     "act": 0.37171052631578944,
     "opp": 0.21445578231292517,
     "act_spread": 0.047697368421052655,
     "peak_token": " burning",
     "peak_char": 47
    },
    {
     "text": "She yanked her hand back the moment she touched the hot iron.",
