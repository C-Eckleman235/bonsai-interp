{
 "examples": [
  {
   "branch": "nerve",
   "text": "Waiting for the exam results was a nerve-racking experience.",
   "act_raw": 5.8125,
   "token": " nerve"
  },
  {
   "branch": "nerve",
   "text": "Er ging mir mit seinen Fragen auf die Nerven.",
   "act_raw": 6.5,
   "token": "erv"
  },
  {
   "branch": "nerve",
   "text": "Sarin is a nerve agent that was banned by treaty.",
   "act_raw": 6.15625,
   "token": " nerve"
  },
  {
   "branch": "nerve",
   "text": "Diabetes can cause nerve damage in the feet.",
   "act_raw": 3.53125,
   "token": " nerve"
  },
  {
   "branch": "nerve",
   "text": "I was a bundle of nerves on my wedding day.",
   "act_raw": 3.4375,
   "token": " nerves"
  },
  {
   "branch": "strong",
   "text": "It was a quiet afternoon, and the cat slept on the windowsill in the sun. The beam was strong.",
   "act_raw": 5.0,
   "token": " strong"
  },
  {
   "branch": "strong",
   "text": "It was a quiet afternoon, and the cat slept on the windowsill in the sun. A strong rope held the boat.",
   "act_raw": 3.375,
   "token": " strong"
  },
  {
   "branch": "strong",
   "text": "The rope was strong enough to hold the piano.",
   "act_raw": 4.21875,
   "token": " strong"
  },
  {
   "branch": "strong",
   "text": "Steel cables are strong and flexible.",
   "act_raw": 3.21875,
   "token": " strong"
  },
  {
   "branch": "strong",
   "text": "It was a quiet afternoon, and the cat slept on the windowsill in the sun. They needed strong boots.",
   "act_raw": 3.421875,
   "token": " strong"
  },
  {
   "branch": "injury",
   "text": "The soldier was shot in the leg during the battle.",
   "act_raw": 3.109375,
   "token": " leg"
  },
  {
   "branch": "injury",
   "text": "She was stabbed in the arm during the robbery.",
   "act_raw": 2.40625,
   "token": " arm"
  },
  {
   "branch": "injury",
   "text": "One man was shot in the leg.",
   "act_raw": 2.578125,
   "token": " leg"
  },
  {
   "branch": "injury",
   "text": "A sniper hit the soldier in the arm.",
   "act_raw": 2.15625,
   "token": " arm"
  }
