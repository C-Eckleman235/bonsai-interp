{
 "examples": [
  {
   "branch": "psychological",
   "text": "Waiting for the exam results was a nerve-racking experience.",
   "act_raw": 5.8125,
   "token": " nerve"
  },
  {
   "branch": "psychological",
   "text": "She finally worked up the nerve to ask for a raise.",
   "act_raw": 6.46875,
   "token": " nerve"
  },
  {
   "branch": "psychological",
   "text": "Parallel parking on a busy street is always a nerve-racking ordeal.",
   "act_raw": 8.4375,
   "token": " nerve"
  },
  {
   "branch": "psychological",
   "text": "Vor der Prüfung war ich mit den Nerven am Ende.",
   "act_raw": 4.75,
   "token": "en"
  },
  {
   "branch": "psychological",
   "text": "La espera fue una guerra de nervios para toda la familia.",
   "act_raw": 2.84375,
   "token": " nerv"
  },
  {
   "branch": "psychological",
   "text": "It took me a week to summon the nerve to call her back.",
   "act_raw": 3.59375,
   "token": " nerve"
  },
  {
   "branch": "anatomical",
   "text": "Повреждение нерва может привести к потере чувствительности. 神经系统负责传递身体各部分的信号。",
   "act_raw": 4.1875,
   "token": "ва"
  },
  {
   "branch": "anatomical",
   "text": "The ulnar nerve passes behind the elbow, which is why hitting it tingles.",
   "act_raw": 2.078125,
   "token": " nerve"
  },
  {
   "branch": "anatomical",
   "text": "Surgeons took care to preserve the facial nerve during the operation.",
   "act_raw": 1.625,
   "token": " nerve"
  },
  {
   "branch": "anatomical",
   "text": "Nerve agents such as sarin disrupt the transmission of signals between neurons.",
   "act_raw": 1.0859375,
   "token": "erve"
  },
  {
   "branch": "name",
   "text": "Control of the glue line – Control of the glue line is another consideration, and the thickness and uniformity of spread should be given constant attention. 신경민 의원은 오늘 국회에서 기자회견을 열었다.",
   "act_raw": 3.25,
   "token": "경"
  },
  {
   "branch": "strong",
   "text": "White appears to have attempted to flee, and was killed by an arrow through the heart. A strong breeze had sprung up and the currents here were rather treacherous.",
   "act_raw": 3.03125,
   "token": " strong"
  }
 ],
