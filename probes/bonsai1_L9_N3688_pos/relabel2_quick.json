     "opp": 0.1524859943977591,
     "act_spread": 0.05652173913043479,
     "peak_token": " the",
     "peak_char": 65
    },
    {
     "text": "The centre for speech lies in the inferior frontal gyrus of the left hemisphere.",
     "act": 0.1914855072463768,
     "opp": 0.042148109243697475,
     "act_spread": 0.18532608695652175,
     "peak_token": " frontal",
     "peak_char": 50
    },
    {
     "text": "Fibres from the frontal lobe descend through the internal capsule to the pons.",
     "act": 0.15579710144927536,
     "opp": 0.05698529411764706,
     "act_spread": 0.17391304347826086,
     "peak_token": " frontal",
     "peak_char": 23
    },
    {
